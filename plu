v></section><section id="equipe"><p class="eyebrow">QUEM FAZ</p><h2>Equipe FlaRádio</h2><div id="team" class="cards"></div></section></main><footer><b>FlaRádio Oficial</b><p>A voz da Nação Rubro-Negra</p><div id="socials"></div><a href="/admin" class="admin-link">Painel administrativo</a></footer><script src="/app.js"></script></body></html>

:root{--red:#d71920;--dark:#101014;--dark2:#19171c;--white:#f7f5f5;--muted:#b7b3bb;--gold:#d5a94b}*{box-sizing:border-box}body{margin:0;background:var(--dark);color:var(--white);font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}.ticker{background:var(--red);padding:10px 5vw;font-size:12px;font-weight:800;letter-spacing:.08em}.top{display:flex;justify-content:space-between;align-items:center;padding:22px 5vw;border-bottom:1px solid #2d2a30;gap:25px}.brand{display:flex;align-items:center;gap:13px}.crest{background:var(--red);border:2px solid white;border-radius:9px;padding:12px;font-weight:900;font-size:18px}.brand b{display:block;font-size:25px;letter-spacing:2px}.brand b span{color:var(--red)}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:2px;margin-top:5px}nav{display:flex;gap:22px;font-size:12px;font-weight:bold}nav a:hover{color:var(--gold}main{padding:0 5vw}.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:30px;padding:65px 0;align-items:center;background:radial-gradient(ellipse at 15% 40%,#3a1217,transparent 65%)}.eyebrow{color:var(--gold);font-size:11px;font-weight:800;letter-spacing:2px}.hero h1{font-size:clamp(38px,6vw,75px);line-height:.98;margin:15px 0}.hero h1 em{color:var(--red);font-style:normal}.hero-copy>p:not(.eyebrow){color:var(--muted);max-width:500px;line-height:1.7}.btn{display:inline-block;background:var(--red);padding:13px 20px;border-radius:4px;font-size:12px;font-weight:bold;margin-top:15px}.player{background:linear-gradient(145deg,#242127,#141316);border:1px solid #39353c;border-radius:12px;padding:28px;box-shadow:0 15px 50px #0005}.live-dot{display:inline-block;width:9px;height:9px;background:#f33;border-radius:50%;margin-right:7px;box-shadow:0 0 14px #f33}.player h2{font-size:24px;margin:18px 0 5px}.player p{color:var(--muted)}audio{width:100%;margin-top:18px;accent-color:var(--red)}.player-note{font-size:11px}.match{background:#201d23;border:1px solid #37323a;border-radius:9px;padding:25px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.match h2{margin:8px 0}.teams{display:flex;align-items:center;gap:28px}.teams>div{display:flex;flex-direction:column;align-items:center;gap:10px}.teams strong{background:var(--red);padding:13px;border-radius:50%;min-width:52px;text-align:center}.teams b{font-size:12px}.score{font-size:30px;font-weight:900}.score small{color:var(--gold)}.match p{color:var(--muted);font-size:12px}section[id]{padding:50px 0}.section-head{display:flex;justify-content:space-between;align-items:end}.section-head h2,section h2{font-size:30px;margin:8px 0 22px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}.card{background:var(--dark2);border:1px solid #343038;border-radius:8px;overflow:hidden;padding:20px}.card img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:5px;margin-bottom:12px}.card .category{color:var(--gold);font-size:10px;font-weight:bold;letter-spacing:1px}.card h3{margin:9px 0}.card p{color:var(--muted);font-size:13px;line-height:1.6}.card a{color:var(--gold);font-size:12px;font-weight:bold}footer{border-top:1px solid #333;padding:30px 5vw;text-align:center;color:var(--muted)}footer b{color:white}footer p{font-size:13px}.admin-link{font-size:11px;opacity:.55;margin-top:15px;display:inline-block}#socials{display:flex;gap:15px;justify-content:center;flex-wrap:wrap;font-size:12px;margin-top:10px}@media(max-width:760px){.top{align-items:flex-start;flex-direction:column}nav{flex-wrap:wrap;gap:14px}.hero{grid-template-columns:1fr;padding:40px 0}.match{justify-content:center;text-align:center}.teams{gap:12px}.score{font-size:25px}}

<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Painel FlaRádio</title><link rel="stylesheet" href="/style.css"><style>body{max-width:950px;margin:auto;padding:25px}.adminbox{background:#201d23;border:1px solid #39353c;border-radius:10px;padding:22px;margin:20px 0}input,textarea{width:100%;padding:12px;margin:8px 0;background:#111;color:#fff;border:1px solid #444;border-radius:5px}textarea{min-height:300px;font-family:monospace}.btn{border:0;cursor:pointer}.status{color:#d5a94b;margin:12px 0}</style></head><body><h1>FlaRádio • Painel administrativo</h1><p><a href="/">← Voltar ao portal</a></p><div class="adminbox" id="loginbox"><h2>Entrar</h2><input id="user" placeholder="Usuário"><input id="pass" type="password" placeholder="Senha"><button class="btn" id="login">Entrar no painel</button><div class="status" id="msg"></div></div><div class="adminbox" id="editbox" hidden><h2>Editar conteúdo do portal</h2><p>Edite o JSON abaixo para atualizar notícias, programação, equipe, links da rádio e placar.</p><textarea id="json"></textarea><button class="btn" id="save">Salvar alterações</button><button class="btn" id="logout">Sair</button><div class="status" id="saveMsg"></div></div><script src="/admin.js"></script></body></html>
