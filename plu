const msg=document.getElementById('msg'),saveMsg=document.getElementById('saveMsg'),loginbox=document.getElementById('loginbox'),editbox=document.getElementById('editbox'),ta=document.getElementById('json');async function load(){const r=await fetch('/api/admin/data');if(r.ok){ta.value=JSON.stringify(await r.json(),null,2);loginbox.hidden=true;editbox.hidden=false;msg.textContent='';return true}return false}document.getElementById('login').onclick=async()=>{msg.textContent='Entrando...';let r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:document.getElementById('user').value,password:document.getElementById('pass').value})});if(r.ok)load();else msg.textContent='Login inválido. Confira usuário e senha.'};document.getElementById('save').onclick=async()=>{try{const obj=JSON.parse(ta.value);saveMsg.textContent='Salvando...';let r=await fetch('/api/admin/data',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(obj)});saveMsg.textContent=r.ok?'Salvo! Atualize a página do portal para conferir.':'Erro ao salvar: '+(await r.text())}catch(e){saveMsg.textContent='JSON inválido: '+e.message}};document.getElementById('logout').onclick=async()=>{await fetch('/api/logout',{method:'POST'});editbox.hidden=true;loginbox.hidden=false};load();

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));fetch('/api/public').then(r=>r.json()).then(d=>{const s=d.settings||{},m=d.match||{};document.title=s.siteName||'FlaRádio Oficial';document.getElementById('ticker').textContent=s.tickerText||s.slogan||'';document.getElementById('heroText').textContent=s.heroText||'';document.getElementById('radioName').textContent=s.radioName||s.siteName||'';document.getElementById('radioNow').textContent=s.radioNow||'';document.getElementById('streamStatus').textContent=s.streamStatusText||'';document.getElementById('audio').src=s.streamUrl||'';document.getElementById('competition').textContent=m.competition||'';document.getElementById('matchStatus').textContent=m.status||'';['homeName','homeBadge','homeScore','awayName','awayBadge','awayScore','venue'].forEach(k=>{if(m[k]!=null)document.getElementById(k).textContent=m[k]});
const news=d.news||[];document.getElementById('news').innerHTML=news.length?news.map(n=>`<article class="card">${n.image?`<img src="${esc(n.image)}" alt="">`:''}<div class="category">${esc(n.category||'NOTÍCIA')}</div><h3>${esc(n.title)}</h3><p>${esc(n.summary||'')}</p>${n.url?`<a href="${esc(n.url)}" target="_blank" rel="noopener">LEIA MAIS →</a>`:''}</article>`).join(''):'<p>Novidades em breve.</p>';
document.getElementById('programs').innerHTML=(d.programs||[]).map(p=>`<article class="card"><div class="category">${esc(p.time||'')}</div><h3>${esc(p.name)}</h3><p>${esc(p.description||'')}</p></article>`).join('')||'<p>Programação em breve.</p>';
document.getElementById('team').innerHTML=(d.team||[]).map(t=>`<article class="card"><h3>${esc(t.name)}</h3><div class="category">${esc(t.role||'')}</div><p>${esc(t.bio||'')}</p></article>`).join('')||'<p>Equipe em breve.</p>';
const socials=[['Instagram',s.instagramUrl],['YouTube',s.youtubeUrl],['WhatsApp',s.whatsappUrl],['TikTok',s.tiktokUrl],['X',s.twitterUrl]].filter(x=>x[1]);document.getElementById('socials').innerHTML=socials.map(x=>`<a href="${esc(x[1])}" target="_blank" rel="noopener">${esc(x[0])}</a>`).join(' • ');
}).catch(()=>document.body.insertAdjacentHTML('beforeend','<p style="padding:20px;color:#f66">Não foi possível carregar o conteúdo. Verifique o servidor.</p>'));

